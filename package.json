{
  "name": "workpacer",
  "productName": "WorkPacer",
  "version": "1.2.0",
  "description": "WorkPacer — Liquid Glass Cross-Platform Desktop Pace & Idle Tracker, Wellness Guardian, Floating Widgets & Daily Report Studio",
  "main": "./out/main/index.js",
  "author": "WorkPacer Engineering",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1 --port 5173",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "rebuild:electron": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run generate:icons && npm run build && electron-builder --win",
    "dist:mac": "npm run generate:icons && npm run build && electron-builder --mac",
    "dist:linux": "npm run generate:icons && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "i18next": "^27.2.9",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "electron@45.5.0": true
  }
}
